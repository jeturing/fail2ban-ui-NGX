# ═══════════════════════════════════════════════════════════════════════════════
# fail2ban-ui — Configuración de Deploy para Host miami-pve (216.106.182.26)
# ═══════════════════════════════════════════════════════════════════════════════
# Protecciones críticas:
# ✅ No bloquear: 216.106.182.26 (servidor principal)
# ✅ No bloquear: 127.0.0.0/8 (localhost)
# ✅ No bloquear: 10.10.20.0/24 (LXC internal)
# ✅ Bind solo a: 127.0.0.1 + Tailscale (NO 0.0.0.0)
# ═══════════════════════════════════════════════════════════════════════════════

# Configuración General
FAIL2BAN_UI_CONFIGURED=1
FAIL2BAN_UI_APP_NAME="Fail2ban UI — miami-pve"
FAIL2BAN_UI_SERVER_NAME="miami-pve (216.106.182.26)"
FAIL2BAN_UI_SERVER_PUBLIC_IP="216.106.182.26"
FAIL2BAN_UI_FRAME_ANCESTORS="'self' https://sajet.us https://www.sajet.us https://app.jeturing.com"
FAIL2BAN_UI_SERVER_LAT=0.0
FAIL2BAN_UI_SERVER_LON=0.0

# 🔒 CRÍTICO: Bind solo a localhost + Tailscale (NUNCA 0.0.0.0)
FAIL2BAN_UI_BIND_HOST="127.0.0.1"
FAIL2BAN_UI_BIND_PORT="8020"

# Ubicación de archivos
FAIL2BAN_UI_JAIL_LOCAL="/etc/fail2ban/jail.local"
FAIL2BAN_UI_CONFIG_PATH="/etc/fail2ban-ui/config.json"
FAIL2BAN_UI_STATE_PATH="/var/lib/fail2ban-ui/state.json"

# Jails a monitorear
FAIL2BAN_UI_JAILS="sshd,portscan,sensible-ports,recidive-48h,blacklist-permanent"

# 🛡️ WHITELIST PROTEGIDA — Redes/IP que NUNCA se banean
# Incluye: servidor host + loopback + LXC internal (SIN protección especial a VPN)
FAIL2BAN_UI_PROTECTED_WHITELIST="127.0.0.0/8,10.10.20.0/24,216.106.182.26/32"

# Autenticación
FAIL2BAN_UI_AUTH_USERNAME="admin"
FAIL2BAN_UI_AUTH_PASSWORD="admin"

# Features
FAIL2BAN_UI_FEATURE_JOURNAL_INSPECTION=1
FAIL2BAN_UI_FEATURE_PORT_INVENTORY=1
FAIL2BAN_UI_FEATURE_WRITE_ACTIONS=1
FAIL2BAN_UI_FEATURE_API_ENABLED=1
FAIL2BAN_UI_FEATURE_SWAGGER_ENABLED=0
FAIL2BAN_UI_FEATURE_EXTERNAL_ENRICHMENT=0
FAIL2BAN_UI_FEATURE_EXTERNAL_LINKS=0
FAIL2BAN_UI_FEATURE_MASK_IPS=1

# UI
FAIL2BAN_UI_PAGE_SIZE=15
FAIL2BAN_UI_AUTO_REFRESH_SECONDS=30
FAIL2BAN_UI_DENSITY="comfortable"

# Decision Engine (recomendaciones automáticas, no auto-ban sin confirmación)
FAIL2BAN_UI_DECISIONS_ENABLED=1
FAIL2BAN_UI_DECISION_MODE="recommend"
FAIL2BAN_UI_DECISION_THRESHOLD=5
FAIL2BAN_UI_DECISION_ACTION_JAIL="blacklist-permanent"
FAIL2BAN_UI_DECISION_NOTIFY_RECOMMENDATIONS=1

# Notch Webhooks (opcional — comentar si no se usa)
# FAIL2BAN_UI_NOTCH_ENABLED=0
# FAIL2BAN_UI_NOTCH_WEBHOOK_URL="https://webhook.example.com/notify"
# FAIL2BAN_UI_NOTCH_TOKEN="bearer_token_here"

# Enriquecimiento externo (opcional)
# FAIL2BAN_UI_IPINFO_TOKEN=""
# FAIL2BAN_UI_SHODAN_KEY=""

# NPM Sidecar (opcional — para sincronizar bans con proxy)
# FAIL2BAN_UI_NPM_ENABLED=0
# FAIL2BAN_UI_NPM_URL="http://10.10.20.205:8888"
# FAIL2BAN_UI_NPM_API_KEY=""
# FAIL2BAN_UI_NPM_SYNC_BANS=0
# FAIL2BAN_UI_NPM_ACCESS_LIST="fail2ban-blocked"

# Sentry (opcional — error tracking)
# FAIL2BAN_UI_SENTRY_DSN=""

# ═══════════════════════════════════════════════════════════════════════════════
# SETUP TOKEN — Token único para completar instalación (cambiar antes de deploy)
# ═══════════════════════════════════════════════════════════════════════════════
FAIL2BAN_UI_SETUP_TOKEN="changeme_unique_setup_token_2026_prod"

# DSAM enrichment bridge (token is stored only in /etc/fail2ban-ui/fail2ban-ui.env)
FAIL2BAN_UI_DSAM_URL="https://sajet.us"
# FAIL2BAN_UI_DSAM_TOKEN="set-in-runtime-env"
